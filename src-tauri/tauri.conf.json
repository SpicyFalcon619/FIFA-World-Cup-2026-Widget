{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "World Cup Widget 26",
  "version": "1.0.8",
  "identifier": "com.wc2026.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WC2026",
        "width": 380,
        "height": 680,
        "minWidth": 340,
        "minHeight": 480,
        "maxWidth": 480,
        "maxHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "center": false,
        "x": 40,
        "y": 80,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.football-data.org https://v3.football.api-sports.io; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SpicyFalcon619/FIFA-World-Cup-2026-Widget/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0N0U0NUEzQUJFRTEzNDIKUldSQ0UrNnJvMFYrTkx3czYwaXZSYWFQRzF1c2ZtRlY1bFFxT2d2c2JNc2E2K0NRK2sxMDNFU2EK"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "oneClick": true
      }
    }
  }
}
